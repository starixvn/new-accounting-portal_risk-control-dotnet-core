{
  "name": "win-limit-control",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start:currency-setting": "ng serve --app=currency-setting --proxy-config proxy.conf.js",
    "build:currency-setting": "ng build --app=currency-setting --prod",
    "postbuild:currency-setting": "gulp --path \"../../wwwroot/currency-setting\"",
    "start:player-setting": "ng serve --app=player-setting --proxy-config proxy.conf.js",
    "build:player-setting": "ng build --app=player-setting --prod",
    "postbuild:player-setting": "gulp --path \"../../wwwroot/player-setting\"",
    "start:monitor": "ng serve --app=monitor --deploy-url http://localhost:4200/wwwroot/monitor --proxy-config proxy.conf.js",
    "build:monitor": "ng build --app=monitor --prod",
    "postbuild:monitor": "gulp --path \"../../wwwroot/monitor\"",
    "test": "ng test",
    "test-coverage": "ng test --code-coverage",
    "lint": "ng lint",
    "ci": "ng test --code-coverage --single-run=true",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^4.2.4",
    "@angular/common": "^4.2.4",
    "@angular/compiler": "^4.2.4",
    "@angular/core": "^4.2.4",
    "@angular/forms": "^4.2.4",
    "@angular/http": "^4.2.4",
    "@angular/platform-browser": "^4.2.4",
    "@angular/platform-browser-dynamic": "^4.2.4",
    "@angular/router": "^4.2.4",
    "@ng-bootstrap/ng-bootstrap": "1.0.0-beta.6",
    "bootstrap": "4.0.0-alpha.6",
    "core-js": "^2.4.1",
    "font-awesome": "^4.7.0",
    "lodash": "^4.17.4",
    "moment": "^2.18.1",
    "nap-components": "^1.0.15",
    "nap-theme": "^1.0.3",
    "ngx-numeric-textbox": "^1.0.0",
    "ngx-pagination": "^3.0.1",
    "ngx-treeview": "1.0.10",
    "numeral": "^2.0.6",
    "rxjs": "^5.4.2",
    "zone.js": "^0.8.14"
  },
  "devDependencies": {
    "@angular/cli": "1.3.2",
    "@angular/compiler-cli": "^4.2.4",
    "@angular/language-service": "^4.2.4",
    "@types/jasmine": "~2.5.53",
    "@types/jasminewd2": "~2.0.2",
    "@types/node": "~6.0.60",
    "cheerio": "^1.0.0-rc.2",
    "codelyzer": "3.0.1",
    "ejs": "^2.5.7",
    "gulp": "^3.9.1",
    "jasmine-core": "~2.6.2",
    "jasmine-spec-reporter": "~4.1.0",
    "karma": "~1.7.0",
    "karma-chrome-launcher": "~2.1.1",
    "karma-cli": "~1.0.1",
    "karma-coverage-istanbul-reporter": "^1.2.1",
    "karma-jasmine": "~1.1.0",
    "karma-jasmine-html-reporter": "^0.2.2",
    "protractor": "~5.1.2",
    "rimraf": "^2.6.1",
    "ts-node": "~3.2.0",
    "tslint": "~5.3.2",
    "typescript": "~2.3.3",
    "yargs": "^8.0.2"
  }
}
