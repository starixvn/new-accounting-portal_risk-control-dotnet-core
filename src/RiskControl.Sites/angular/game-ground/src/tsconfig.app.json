{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "baseUrl": "./",
    "module": "es2015",
    "types": ["node"],
    "paths": {
      "@angular/*": [
        "../node_modules/@angular/*"
      ],
      "@ng-bootstrap/ng-bootstrap": [
        "../node_modules/@ng-bootstrap/ng-bootstrap"
      ],
      "ngx-pagination": [
        "../node_modules/ngx-pagination"
      ],
      "rxjs/*": [
        "../node_modules/rxjs/*"
      ]
    }
  },
  "exclude": [
    "testing",
    "test.ts",
    "**/*.spec.ts"
  ]
}
