{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "typescript",
            "tsconfig": "RiskControl.Sites\\tsconfig.json",
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "taskName": "build",
            "command": "dotnet build",
            "args": [
                "${workspaceRoot}/RiskControl.Sites/RiskControl.Sites.csproj"
            ],
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}