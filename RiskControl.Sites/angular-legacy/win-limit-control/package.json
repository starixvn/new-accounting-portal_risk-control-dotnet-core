  "license": "MIT",
  "scripts": {
    "start:currency-setting": "ng serve currency-setting --proxy-config proxy.conf.js",
    "build:currency-setting": "ng build currency-setting --configuration production",
    "postbuild:currency-setting": "gulp --path \"../../wwwroot/currency-setting\"",
    "start:manage-setting-group": "ng serve manage-setting-group --proxy-config proxy.conf.js",
    "build:manage-setting-group": "ng build manage-setting-group --configuration production",
    "postbuild:manage-setting-group": "gulp --path \"../../wwwroot/manage-setting-group\"",
    "start:player-setting": "ng serve player-setting --proxy-config proxy.conf.js",
    "build:player-setting": "ng build player-setting --configuration production",
    "postbuild:player-setting": "gulp --path \"../../wwwroot/player-setting\"",
    "start:monitor": "ng serve monitor --proxy-config proxy.conf.js",
    "build:monitor": "ng build monitor --configuration production",
    "postbuild:monitor": "gulp --path \"../../wwwroot/monitor\"",
    "test": "ng test currency-setting",
    "test-coverage": "ng test --code-coverage",
    "lint": "ng lint",
    "ci": "ng test --code-coverage --single-run=true",
    "e2e": "ng e2e"
  },
