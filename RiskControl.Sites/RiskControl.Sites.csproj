    <PackageReference Include="Fanex.Logging.Extensions" Version="2.0.2.1" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
    <PackageReference Include="Fanex.NAP.Client" Version="2.0.3" />
    <PackageReference Include="Fanex.NAP.SignIn" Version="2.0.3.3" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="9.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ONEbook.UM" Version="3.2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\RiskControl.Application\RiskControl.Application.csproj" />
    <ProjectReference Include="..\src\RiskControl.BettingMonitoring\RiskControl.BettingMonitoring.csproj" />
    <ProjectReference Include="..\src\RiskControl.FailSafeSystem\RiskControl.FailSafeSystem.csproj" />
    <ProjectReference Include="..\src\RiskControl\RiskControl.csproj" />
    <ProjectReference Include="..\src\RiskControl.Dashboard\RiskControl.Dashboard.csproj" />
