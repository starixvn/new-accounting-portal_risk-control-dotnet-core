<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
	<!-- Exclude the project from analysis -->
	<SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="angular-legacy\**" />
    <Compile Remove="angular\**" />
    <Compile Remove="Services\**" />
    <Content Remove="angular-legacy\**" />
    <Content Remove="angular\**" />
    <Content Remove="Services\**" />
    <EmbeddedResource Remove="angular-legacy\**" />
    <EmbeddedResource Remove="angular\**" />
    <EmbeddedResource Remove="Services\**" />
    <None Remove="angular-legacy\**" />
    <None Remove="angular\**" />
    <None Remove="Services\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Templates\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Include="Views\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="Fanex.Caching" Version="2.2.8" />
