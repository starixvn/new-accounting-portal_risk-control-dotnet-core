{
  "name": "fail-safe-system",
  "version": "0.0.0",
  "scripts": {
    "start:fss-setting": "ng serve fail-safe-system-setting --proxy-config proxy.conf.json",
    "build:fss-setting": "ng build fail-safe-system-setting --configuration production",
    "postbuild:fss-setting": "gulp --path \"../../wwwroot/fail-safe-system-setting\"",
    "start:fss-monitor": "ng serve fail-safe-system-monitor --proxy-config proxy.conf.json",
    "build:fss-monitor": "ng build fail-safe-system-monitor --configuration production",
    "postbuild:fss-monitor": "gulp --path \"../../wwwroot/fail-safe-system-monitor\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~12.2.0",
    "@angular/common": "~12.2.0",
    "@angular/compiler": "~12.2.0",
    "@angular/core": "~12.2.0",
    "@angular/forms": "~12.2.0",
    "@angular/platform-browser": "~12.2.0",
    "@angular/platform-browser-dynamic": "~12.2.0",
    "@angular/router": "~12.2.0",
    "@ng-bootstrap/ng-bootstrap": "^10.0.0",
    "bootstrap": "^4.6.0",
    "core-js": "^2.5.7",
    "font-awesome": "^4.7.0",
    "lodash": "^4.17.11",
    "moment": "^2.22.2",
    "nap-components": "^12.2.20",
    "nap-theme": "^12.2.11",
    "ngx-pagination": "^6.0.2",
    "ngx-treeview": "^10.0.2",
    "node-sass": "^7.0.1",
    "numeral": "^2.0.6",
    "rxjs": "~6.6.0",
    "rxjs-compat": "^6.3.3",
    "sass-loader": "^13.0.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~12.2.12",
    "@angular/cli": "~12.2.12",
    "@angular/compiler-cli": "~12.2.0",
    "@types/jasmine": "~3.8.0",
    "@types/node": "^12.11.1",
    "cheerio": "^1.0.0-rc.1",
    "ejs": "^2.6.1",
    "gulp": "^4.0.2",
    "jasmine-core": "~3.8.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "typescript": "~4.3.5"
  }
