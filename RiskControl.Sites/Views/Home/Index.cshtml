@{
    ViewBag.Title = "Risk &#38; Control";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    <link href="@Url.Content("~/content/themes/home.css")" rel="stylesheet" />
}
@section Headline
{
    <div class="alert-browser">
        You are using a browser that is not supported by this site.
        <br />
        Please upgrade your browser now to Firefox 49+ or Chrome 54+ by openning the following link <a href="http://outdatedbrowser.com/en" target="_blank">http://outdatedbrowser.com/en</a>
    </div>
}
<div class="home-info">
    <div>
        <div id="welcome">Welcome <span id="user">@Context.User.Identity.Name</span><br /> to Risk &#38; Control</div>
        <div id="button">
            <a id="change-pass" href="@Url.Content("~/Auth/ChangePassword")">Change Password</a>
            <a id="logout" href="@Url.Content("~/Auth/LogOut")">Sign Out</a>
        </div>
        <div id="time">@string.Format("{0} GMT-4", DateTime.Now)</div>
    </div>
    <div style="width: 50px;"></div>
    <div>
        <img src="@Url.Content("~/content/themes/img/welcome.png")" />
    </div>
</div>
@section Foot
{
    <script type="text/javascript">
        (function () {
            function isBrowserSupported() {
                try {
                    var matches = navigator.userAgent.match(/(opera|chrome|safari|firefox|msie|trident(?=\/))\/?\s*(\d+)/i) || [];
                    if (matches[1] === 'Firefox') {
                        return parseInt(matches[2]) >= 49;
                    }

                    if (matches[1] === 'Chrome') {
                        return parseInt(matches[2]) >= 54;
                    }
                }
                finally { }
                return false;
            }

            if (!isBrowserSupported()) {
                $('.alert-browser').show();
            }
        }());
    </script>
}