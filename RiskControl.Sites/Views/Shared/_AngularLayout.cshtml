@{
	var baseHref = Context.Request.PathBase;
	if (baseHref != "/")
	{
		baseHref = baseHref + "/";
	}
}
<!doctype html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="@baseHref">
	<link rel="icon" type="image/x-icon" href="@Url.Content("favicon.ico")">
	<title>@Html.Raw(ViewBag.Title)</title>
	@RenderSection("Head", false)
</head>
<body>
	@RenderBody()
	<script src="@Url.Content("~/nap-auth/re-checkin.js")" type="text/javascript"></script>
	<!-- Google tag (gtag.js) -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-EKH69QFTYD"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){
			dataLayer.push(arguments);
		}   
		gtag('js', new Date());   
		gtag('config', 'G-EKH69QFTYD');
		gtag('username', '@Context.User.Identity.Name');
	</script>
</body>
</html>