@{
    var showMenus = ViewBag.ShowMenus != null ? (bool)ViewBag.ShowMenus : true;
    var napConfig = new
    {
        Today = Convert.ToInt64(DateTime.Now
           .Subtract(new DateTime(1970, 1, 1, 0, 0, 0))
           .TotalMilliseconds),
        RootUrl = Url.Content("~").TrimEnd(new[] { '/' })
    };
}
<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en" data-ng-app="app.@ViewBag.AppName" data-ng-strict-di>
<!--<![endif]-->
<head>
    <meta charset="utf-8" />
    <title>Risk &#38; Control - @ViewBag.Title</title>
    <link rel="shortcut icon" href="~/content/Themes/img/site.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
    <!--[if lt IE 9]><script src="~/Scripts/Libs/html5-libs/html5shiv.min.js" type="text/javascript"></script><![endif]-->
    <link href="@Url.Content("~/content/themes/style.css")" rel="stylesheet" />
    <link href="@Url.Content("~/scripts/libs/tipsy/tipsy.css")" rel="stylesheet" />
    @RenderSection("Head", false)
    <script type="text/javascript">
        var napConfig = @Html.Raw(Json.Serialize(napConfig));
    </script>
</head>
<body>
    @if (showMenus)
    {
    <header>
        <div class="logo">
            <a href="~/?ref=logo"></a>
        </div>
        @await Component.InvokeAsync("Menu")
        <div class="user-info">
            <div class="greeting">
                <h2>Welcome <span class="info-acc">@Context.User.Identity.Name</span><span class="info-more"></span></h2>
                <ul>
                    <li><a href="@Url.Content("~/Auth/ChangePassword")">Change Password</a></li>
                    <li><a href="@Url.Content("~/Auth/LogOut")">Sign Out</a></li>
                </ul>
            </div>
        </div>
    </header>
    }
    <section id="headline">
        @if (showMenus)
        {
            <span class="server-time">@string.Format("{0} GMT-4", DateTime.Now)</span>
        }
        @RenderSection("Headline", false)
    </section>
    <section id="body">
        <div class="content">
            @RenderBody()
        </div>
    </section>
    <div id="dialog-popup"></div>
    <script type="text/javascript" src="@Url.Content("~/scripts/libs/jquery/jquery-1.8.2.min.js")"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WTBZ86ET8V"></script>
    <script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){
			dataLayer.push(arguments);
		}   
		gtag('js', new Date());   
		gtag('config', 'G-WTBZ86ET8V');
		gtag('username', @Context.User.Identity.Name);
	</script>
    @RenderSection("Foot", false)
</body>
</html>